# Скопировать в .env и заполнить. Комментарий в строке допустим,
# но перед # обязателен пробел — иначе он попадёт в значение.

CONFLUENCE_URL=https://confluence.вашдомен
CONFLUENCE_PERSONAL_TOKEN=ваш_pat
CONFLUENCE_SSL_VERIFY=false
ALLOW_GLOBAL_CRED_FALLBACK=true

# Прокси Docker Desktop не должен применяться к внутреннему Confluence
NO_PROXY=confluence.вашдомен,localhost,127.0.0.1

# Jira не нужна — JIRA_* не задаём

TRANSPORT=streamable-http
STATELESS=true
PORT=8010
HOST=0.0.0.0

TOOLSETS=confluence_pages
CONFLUENCE_SPACES_FILTER=TECHDOC
READ_ONLY_MODE=false
MCP_VERBOSE=true

# Разрешаем только просмотр, создание и редактирование страниц.
# Удаление, перенос, копирование и управление ограничениями не показываются Cursor.
ENABLED_TOOLS=confluence_search,confluence_get_page,confluence_get_page_children,confluence_get_space_page_tree,confluence_get_page_history,confluence_get_page_diff,confluence_create_page,confluence_update_page,confluence_update_page_section
